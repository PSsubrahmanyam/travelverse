# Server Port
PORT=5000

# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/anti-travel?retryWrites=true&w=majority

# Google Gemini AI API Key (Get a free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173
